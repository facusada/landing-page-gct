# ============================================================
# Orquestación Docker / deploy (raíz)
# ============================================================
# Este archivo lo consume docker-compose.yml en el servidor.
# Es gitignored en su versión real (.env): debe existir en el server.

# Mapeo de puertos Docker del frontend (host:contenedor). Ej: 8081:3000
PORT_BINDING=PORT_BINDING

# Puerto interno de la app dentro del contenedor
PORT=PORT

# IP fija del contenedor frontend en la red nginx_red_compartida
IPV4_ADDRESS=IPV4_ADDRESS

# IP fija del contenedor backend (API) en la red nginx_red_compartida
IPV4_ADDRESS_API=IPV4_ADDRESS_API

# ============================================================
# Frontend (Nuxt) — se inyectan al contenedor del sitio
# ============================================================
# URL pública del sitio (para canonical, JSON-LD y sitemap)
NUXT_PUBLIC_SITE_URL=NUXT_PUBLIC_SITE_URL

# Email de contacto público
NUXT_PUBLIC_CONTACT_EMAIL=NUXT_PUBLIC_CONTACT_EMAIL

# URL PÚBLICA del backend (la usa el navegador al enviar el formulario).
# Debe ser accesible desde afuera vía nginx, NO la IP interna de Docker.
# Ej: https://www.gctechs.com  (nginx rutea /api/ -> landing-api:8000)
NUXT_PUBLIC_API_BASE=NUXT_PUBLIC_API_BASE
