# ============================================================
# Orquestación Docker / deploy (raíz)
# ============================================================
# Lo consume docker-compose.yml en el servidor. La versión real (.env)
# es gitignored y debe existir en el server.
# Los contenedores se resuelven por nombre dentro de la red
# nginx_red_compartida (no hacen falta IPs fijas).

# Mapeo de puertos Docker del frontend (host:contenedor). Ej: 8081:80
PORT_BINDING=PORT_BINDING

# Puerto interno de la app dentro del contenedor
PORT=PORT

# ============================================================
# Frontend (Nuxt) — se inyectan al contenedor del sitio
# ============================================================
# URL pública del sitio (para canonical, JSON-LD y sitemap)
NUXT_PUBLIC_SITE_URL=NUXT_PUBLIC_SITE_URL

# Email de contacto público
NUXT_PUBLIC_CONTACT_EMAIL=NUXT_PUBLIC_CONTACT_EMAIL

# URL pública del backend (la usa el navegador al enviar el formulario).
# Mismo dominio del sitio: nginx rutea /api/ -> gct-landing-api:8000.
# Ej: https://landing.gctechs.com
NUXT_PUBLIC_API_BASE=NUXT_PUBLIC_API_BASE
