# Entorno
APP_ENV=development

# ============================================================
# Backend de correo
# ============================================================
# graph -> envía por Microsoft Graph (producción)
# log   -> NO envía: imprime el correo en el log del backend (desarrollo / tests)
MAIL_BACKEND=log

# ============================================================
# Microsoft Graph — OAuth 2.0 client credentials
# App Registration en Entra ID: gctechs-landing-mailer
# (permiso Microsoft Graph -> Mail.Send de tipo Application, con admin consent)
# ============================================================
# Requeridas solo cuando MAIL_BACKEND=graph. Nunca commitear valores reales.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Timeout (segundos) de lectura para token + sendMail. Conexión: 5s fijos.
GRAPH_TIMEOUT_SECONDS=20

# ============================================================
# Direcciones de correo
# ============================================================
# MAIL_FROM debe ser el UPN de un buzón real de Exchange Online (sirve un buzón
# compartido). Es el {buzón} de POST /users/{buzón}/sendMail.
MAIL_FROM=no-reply@gctechs.com
MAIL_FROM_NAME=Global Core Technologies
MAIL_TO=info@gctechs.com

# ============================================================
# CORS — orígenes permitidos, separados por coma
# ============================================================
# Desarrollo (frontend Nuxt local):
ALLOWED_ORIGINS=http://localhost:3000
# Producción (solo los dominios públicos del sitio, sin localhost):
# ALLOWED_ORIGINS=https://gctechs.com,https://www.gctechs.com
