# Entorno
APP_ENV=development

# ============================================================
# SMTP
# ============================================================
# --- MODO TEST (MailHog) ---
# MailHog captura los correos sin enviarlos. Web UI: http://localhost:8025
# Si corrés el backend con uvicorn y MailHog en Docker, usá localhost:1025.
# Si corrés todo con docker-compose.dev.yml, el host es "mailhog".
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# --- MODO PRODUCCIÓN (ejemplo) ---
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=usuario-smtp
# SMTP_PASSWORD=contraseña-smtp
# STARTTLS (587)        -> SMTP_USE_TLS=true  / SMTP_USE_SSL=false
# TLS implícito (465)   -> SMTP_USE_TLS=false / SMTP_USE_SSL=true

# ============================================================
# Direcciones de correo
# ============================================================
MAIL_FROM=no-reply@gctechs.com
MAIL_FROM_NAME=Global Core Technologies
MAIL_TO=info@gctechs.com

# ============================================================
# CORS — orígenes permitidos, separados por coma
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,https://www.gctechs.com
