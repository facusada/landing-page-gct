# Frontend (Nuxt) — variables para desarrollo local.
# En producción estas vars las inyecta docker-compose desde el .env de la raíz.

# Puerto del dev server / SSR
PORT=PORT

# URL pública del sitio (canonical, JSON-LD, sitemap)
NUXT_PUBLIC_SITE_URL=NUXT_PUBLIC_SITE_URL

# Email de contacto público
NUXT_PUBLIC_CONTACT_EMAIL=NUXT_PUBLIC_CONTACT_EMAIL

# URL pública del backend (API del formulario de contacto)
NUXT_PUBLIC_API_BASE=NUXT_PUBLIC_API_BASE
