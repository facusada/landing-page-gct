# Flat (npm-like) node_modules layout. Note: this alone does NOT fix the
# Nitro ELOOP on the Docker build — Nitro recreates the circular
# vue <-> @vue/server-renderer symlinks regardless of the install linker
# (the real fix is the build guard in the Dockerfile). Kept because the
# flat layout is simpler and avoids pnpm phantom-dependency surprises.
node-linker=hoisted
