# Use a flat (npm-like) node_modules layout.
# pnpm's default symlinked layout creates a circular link between
# `vue` and `@vue/server-renderer`, which Nitro's node-server preset
# reproduces in .output/server/node_modules and then trips over with
# `ELOOP: too many symbolic links` during the production build (seen on
# the Linux/Docker deploy). A hoisted layout removes the nesting entirely.
node-linker=hoisted
